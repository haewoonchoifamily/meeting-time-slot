{
  "name": "meeting-time-slot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meeting-time-slot",
      "database_id": "8c656885-1c24-4192-965f-1f75944c626f"
    }
  ],
  "vars": {
    "MODEL": "claude-sonnet-5-5"
  }
}
